# Database (SQLite by default; switch to postgresql for production)
DATABASE_URL="file:./dev.db"

# Public URL of this app once deployed, used to build landing page links for ads
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Maps Geocoding API (https://console.cloud.google.com/apis)
GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API (Meta Business Manager -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=

# Facebook/Instagram Ads (Meta Business Manager)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Google Ads API (https://developers.google.com/google-ads/api/docs/get-started)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
