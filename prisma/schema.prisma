// Data model for the freight lead-generation platform.
// Default datasource is SQLite for zero-config local dev.
// For production, switch provider to "postgresql" and set DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single freight requirement submitted through a landing page, the REST
// endpoint, or the MCP tool - all three go through the same lib/leads.ts
// pipeline, so this is the one and only lead table.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Where it came from
  sourceSlug String? // landing page slug, e.g. "shanghai-freight-forwarding"
  sourceUrl  String? // full URL the visitor was on
  channel    String  @default("web") // web | api | mcp

  // Contact
  contactName String
  company     String?
  email       String
  phone       String

  // Shipment
  originCountry      String
  originCity         String?
  destinationCountry String
  destinationCity    String?
  cargo              String
  quantity           String?
  weightKg           Float?
  cbm                Float?
  packageCount       Int?
  mode               String // sea | air | road | rail | not_sure
  container          String? // LCL | 20GP | 40GP | 40HQ | not_sure
  incoterm           String? // EXW | FCA | FOB | CIF | DAP | DDP | not_sure
  cargoReadyDate     String?
  specialRequirements String?
  notes              String?

  consent Boolean @default(false)

  // Internal pipeline - private, admin-only
  status     String @default("NEW") // NEW | CONTACTED | QUALIFIED | QUOTE_IN_PROGRESS | QUOTE_SENT | WON | LOST
  adminNotes String?
}

// Organic content calendar: posts to channels the business owns and
// controls (its own Facebook/Instagram Page, its own Google Business
// Profile) via each platform's official API. Never third-party groups,
// forums, or accounts that aren't ours.
model SocialPost {
  id            String    @id @default(cuid())
  platform      String // facebook_page | instagram | google_business
  content       String
  imageUrl      String?
  linkUrl       String?
  landingSlug   String?
  scheduledFor  DateTime
  status        String    @default("pending") // pending | posted | failed
  externalId    String?
  failureReason String?
  createdAt     DateTime  @default(now())
  postedAt      DateTime?
}
