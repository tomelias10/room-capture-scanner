// Data model for the delivery leads platform.
// Default datasource is SQLite for zero-config local dev.
// For production, switch provider to "postgresql" and set DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  phone         String
  category      String // matches LandingPageConfig.shipmentType, e.g. "local_delivery"
  commissionPct Float // e.g. 0.10 = 10%
  lat           Float
  lng           Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  deals         Deal[]
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  region       String
  shipmentType String
  address      String?
  lat          Float?
  lng          Float?
  consent      Boolean  @default(false)
  source       String? // landing page slug this lead came from
  createdAt    DateTime @default(now())
  deal         Deal?
}

model Deal {
  id            String   @id @default(cuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  dealValue     Float?
  commissionPct Float
  commissionAmt Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
